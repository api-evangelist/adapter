{
  "opencollection": "1.0.0",
  "info": {
    "name": "Adapter Adapter API Openapi.json API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Openapi.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Openapi Endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.adapter.com/openapi.json",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Secured OpenAPI schema endpoint."
        }
      ]
    }
  ],
  "bundled": true
}